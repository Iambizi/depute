{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-components": "rm -rf src/depute && mkdir -p src/depute && tar -C ../.. --exclude='*.test.ts' --exclude='*.test.tsx' --exclude='*.test.js' -cf - src | tar -C src/depute --strip-components=1 -xf -",
    "predev": "npm run sync-components",
    "dev": "next dev",
    "prebuild": "npm run sync-components",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "framer-motion": "^12.35.0",
    "fumadocs-core": "^16.6.8",
    "fumadocs-mdx": "14.2.14",
    "fumadocs-typescript": "^5.2.0",
    "fumadocs-ui": "^16.6.8",
    "geist": "^1.7.0",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
