{
  "name": "ax-components-react",
  "version": "0.5.1",
  "description": "React component library for human-in-the-loop oversight in agentic applications. Approval gates, plan cards, tool traces, confidence meters, run controls, and more.",
  "homepage": "https://depute.dev",
  "keywords": [
    "react",
    "typescript",
    "ai-agents",
    "agentic-ui",
    "human-in-the-loop",
    "ai-ui",
    "approval-workflows",
    "llm",
    "agent-ux",
    "delegation-ui",
    "agent-oversight",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/ax-components.cjs.js",
  "module": "./dist/ax-components.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ax-components.es.js",
      "require": "./dist/ax-components.cjs.js"
    },
    "./utils": {
      "types": "./dist/types/utils/mockData.d.ts",
      "import": "./dist/utils.es.js",
      "require": "./dist/utils.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "test:coverage": "vitest run --dir src --coverage",
    "lint": "eslint .",
    "checksums": "node scripts/generate-checksums.mjs",
    "checksums:check": "node scripts/verify-checksums.mjs",
    "test:core": "vitest run --config vitest.core.config.ts",
    "schema:core": "node scripts/generate-core-schema.mjs",
    "schema:core:check": "node scripts/generate-core-schema.mjs --check",
    "types:core": "node scripts/sync-presented-types.mjs",
    "types:core:check": "node scripts/sync-presented-types.mjs --check",
    "styles:check": "node scripts/check-styles.mjs",
    "type-check": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.6.2",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
